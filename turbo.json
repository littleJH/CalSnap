{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "bootstrap": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["^analyze"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
